{
  "name": "spankki-wa",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "PUBLIC_URL": "https://spankki-wa.bogdan-c-2206.workers.dev",
    "DEMO_TODAY": "2026-10-06",
    "INSTANCE": "49"
  },
  "containers": [
    {
      "class_name": "Coach",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "./Dockerfile" } }
    }
  ],
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "COACH", "class_name": "Coach" }]
  },
  "exports": {
    "Coach": { "type": "durable-object", "storage": "sqlite" }
  },
  "triggers": { "crons": ["0 7,12,17 * * *"] },
  "observability": { "enabled": true }
}
