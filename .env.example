# Anthropic
ANTHROPIC_API_KEY=
# WhatsApp Cloud API (Meta)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=pick-any-random-string
# The demo user's WhatsApp number, digits with country code (e.g. 40712345678)
DEMO_PHONE=
# Public base URL of this server (cloudflared tunnel), no trailing slash
PUBLIC_URL=https://spankki-wa.bogdan-c-2206.workers.dev
# Path to the S-Pankki dataset folder
DATA_DIR=../ref/Junction-2026-S-pankki
# "Today" inside the demo (dataset ends 2026-09-30)
DEMO_TODAY=2026-10-06
PERSONA_ID=CUST04831
# Who the web app and the WhatsApp demo phone show by default (data/personas/index.json); empty = the hero, Antti
DEMO_PERSONA=

# Oiva's voice in the web chat's Helper mode (ElevenLabs text-to-speech; server only, never sent to the browser).
# Empty = the browser's own voice. Voice ID empty = "George" (JBFqnCBsd6RMkjVDRZzb); model eleven_multilingual_v2.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Characters sent to ElevenLabs per day at most (repeats are cached and free); default 40000
ELEVENLABS_DAILY_CHARS=
# Enable Banking (another bank, real data). App ID + the app's private key (PEM; \n for newlines is fine)
EB_APP_ID=
EB_PRIVATE_KEY=
